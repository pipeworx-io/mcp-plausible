[
  {
    "name": "plausible_overview",
    "description": "Return aggregate visitors, visits, pageviews, bounce rate, visit duration, and optional goal revenue for a Plausible site. Answers how much traffic and engagement the site generated during a period.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Plausible Stats API key"
        },
        "site_id": {
          "type": "string",
          "description": "Plausible site ID, usually the configured domain such as example.com"
        },
        "date_range": {
          "description": "Plausible date range preset or a two-item ISO date array",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "day",
                "24h",
                "7d",
                "28d",
                "30d",
                "91d",
                "month",
                "6mo",
                "12mo",
                "year",
                "all"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "include_revenue": {
          "type": "boolean",
          "description": "Include total_revenue and average_revenue; use with a revenue goal filter"
        },
        "goal": {
          "type": "string",
          "description": "Limit metrics to one configured goal display name"
        }
      },
      "required": [
        "_apiKey",
        "site_id",
        "date_range"
      ]
    }
  },
  {
    "name": "plausible_timeseries",
    "description": "Return bounded Plausible metrics grouped by day, week, month, or hour. Answers when traffic, engagement, conversions, or revenue changed during a period.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Plausible Stats API key"
        },
        "site_id": {
          "type": "string",
          "description": "Plausible site ID, usually the configured domain such as example.com"
        },
        "date_range": {
          "description": "Plausible date range preset or a two-item ISO date array",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "day",
                "24h",
                "7d",
                "28d",
                "30d",
                "91d",
                "month",
                "6mo",
                "12mo",
                "year",
                "all"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "interval": {
          "type": "string",
          "enum": [
            "hour",
            "day",
            "week",
            "month"
          ],
          "description": "Time bucket"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Plausible metric names; defaults to visitors and pageviews"
        },
        "goal": {
          "type": "string",
          "description": "Limit metrics to one configured goal display name"
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum rows, default 100 and maximum 500"
        }
      },
      "required": [
        "_apiKey",
        "site_id",
        "date_range",
        "interval"
      ]
    }
  },
  {
    "name": "plausible_breakdown",
