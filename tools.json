      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Plausible Stats API key"
        },
        "site_id": {
          "type": "string",
          "description": "Plausible site ID, usually the configured domain such as example.com"
        },
        "date_range": {
          "description": "Plausible date range preset or a two-item ISO date array",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "day",
                "24h",
                "7d",
                "28d",
                "30d",
                "91d",
                "month",
                "6mo",
                "12mo",
                "year",
                "all"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "dimension": {
          "type": "string",
          "description": "Plausible dimension such as visit:source, visit:utm_campaign, event:page, visit:country_name, or event:props:plan"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Metrics; defaults to visitors and pageviews"
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
